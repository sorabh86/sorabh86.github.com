rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Restrict access to user data
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == "admin"); // Users can read their own data, admins can read all
      allow update: if request.auth != null && request.auth.uid == uid && !(request.resource.data.role != resource.data.role); // Users can update their data but NOT change 'role'
      allow write: if request.auth != null && request.auth.uid == uid; // Users can create their own document
      allow write: if request.auth.token.role == "admin"; // Admins can manage all users
    }

    // Example: If you have a 'posts' collection
    match /posts/{postId} {
      allow read: if request.auth != null; // All authenticated users can read posts
      allow write: if request.auth != null && request.auth.token.role == "admin"; // Only admins can create/edit posts
    }
    
    // Secure messages collection
    match /messages/{messageId} {
      allow read: if request.auth != null; // Any authenticated user can read
      allow create: if request.auth != null; // Only logged-in users can write
    }

  }
}
